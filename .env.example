# Public web origin used for canonical links and callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPOSITORY_URL=https://github.com/Mukhsin0508/Dramatic

# Public API origin embedded in the native bundle. This is not a secret.
# Use your computer's LAN IP for a physical device, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Server-only Higgsfield credential pair. Keep this out of EXPO_PUBLIC_* and NEXT_PUBLIC_*.
# Use the documented KEY_ID:KEY_SECRET shape. HF_CREDENTIALS is also supported.
HIGGSFIELD_API_KEY=replace-key-id:replace-key-secret

# Use https://dev-api.higgsfield.com for development keys.
HIGGSFIELD_API_BASE_URL=https://platform.higgsfield.ai

# Hard ceiling for the sum of provider estimates before a pilot run submits work.
HIGGSFIELD_MAX_USD=5

# Live landing-page generation demo (/api/demo/poster). All server-side.
# DEMO_GENERATION=off disables the endpoint entirely.
# DEMO_MAX_USD caps the estimated cost of a single request (default 0.15).
# DEMO_DAILY_MAX_USD caps per-instance daily spend (default 2).
# DEMO_WAIT_MS caps how long the function waits for the render (default 280000).
