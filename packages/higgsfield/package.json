{
  "name": "@dramatic/higgsfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": "24.x"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src/generated/README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist coverage",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@higgsfield/client": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "rimraf": "6.1.2",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
